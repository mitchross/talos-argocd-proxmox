{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  prHourlyLimit: 3,
  enabledManagers: [
    'helm-values',
    'kubernetes',
    'kustomize',
    'argocd',
    'terraform',
    'dockerfile',
    'custom.regex',
  ],
  argocd: {
    managerFilePatterns: [
      '/^infra/.+\\.yaml$/',
      '/^infrastructure/.+\\.yaml$/',
      '/^apps/.+\\.yaml$/',
      '/^my-apps/.+\\.yaml$/',
      '/^monitoring/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/^infra/.+\\.yaml$/',
      '/^infrastructure/.+\\.yaml$/',
      '/^apps/.+\\.yaml$/',
      '/^my-apps/.+\\.yaml$/',
      '/^monitoring/.+\\.yaml$/',
      '/^iac/.+\\.yaml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/^infra/.+/values\\.yaml$/',
      '/^apps/.+/values\\.yaml$/',
      '/^monitoring/.+/values\\.yaml$/',
      '/^my-apps/.+/values\\.yaml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '(^|/)kustomization\\.ya?ml$',
    ],
  },
  terraform: {
    managerFilePatterns: [
      '//^iac/terraform/.+\\.tf$//',
    ],
  },
  dockerfile: {
    managerFilePatterns: [
      '//^docker/.+/Dockerfile$//',
    ],
  },
  packageRules: [
    {
      description: 'Group ALL container digest pins into one rolling PR. Version bumps stay as separate PRs. Placed first so more-specific rules (PostHog group, etc.) override this groupName.',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'all container digests',
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchManagers: [
        'helm-values',
        'kubernetes',
        'kustomize',
        'argocd',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      matchManagers: [
        'helm-values',
        'kubernetes',
        'kustomize',
        'argocd',
      ],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'Cilium never automerges — read the release notes and roll it deliberately.',
      matchPackageNames: [
        'cilium',
      ],
      automerge: false,
    },
    {
      description: 'Longhorn upgrades require review of storage recovery and chart changes.',
      matchPackageNames: [
        'longhorn',
      ],
      automerge: false,
    },
    {
      description: 'Enable container digest updates',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      enabled: true,
    },
    {
      description: 'Handle llama.cpp upstream versioning (CUDA 13 build)',
      matchPackageNames: [
        'ghcr.io/ggml-org/llama.cpp',
      ],
      // GPU driver supports CUDA 13 and upstream stopped publishing server-cuda12 tags, so track server-cuda13.
      // See docs/domains/ai-gpu/3090-llm-optimization.md.
      versioning: 'regex:^server-cuda13-b(?<major>\\d+)$',
    },
    {
      description: 'Ignore NVIDIA CUDA updates (breaking changes)',
      enabled: false,
      matchPackageNames: [
        '/^nvidia/cuda/',
        '/^nvcr.io/nvidia/cuda/',
      ],
    },
    {
      description: 'Ignore Meilisearch updates (breaking changes)',
      enabled: false,
      matchPackageNames: [
        '/^getmeili/meilisearch/',
      ],
    },
    {
      description: 'SearXNG uses date-based tags (YYYY.M.DD-hash)',
      matchPackageNames: [
        'ghcr.io/searxng/searxng',
      ],
      versioning: 'regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$',
    },
    {
      description: 'radar-ng Open-Meteo: block known-bad 1.5.3 image, which is missing libparquet-glib.so.2400 and crashloops the forecast API. Allow 1.5.4+ only after human review.',
      matchPackageNames: [
        'ghcr.io/open-meteo/open-meteo',
      ],
      matchFileNames: [
        'my-apps/personal-projects/radar-ng/deployment-open-meteo.yaml',
      ],
      allowedVersions: '<1.5.3 || >=1.5.4',
      automerge: false,
    },
    {
      description: 'Radar Open-Meteo serve and sync share one image and must be reviewed and updated atomically.',
      matchPackageNames: [
        'ghcr.io/mitchross/radar-ng-open-meteo-worker',
      ],
      matchFileNames: [
        'my-apps/personal-projects/radar-ng/deployment-open-meteo.yaml',
      ],
      groupName: 'radar open-meteo image',
      automerge: false,
    },
    {
      description: 'Radar worker bumps are Temporal worker releases: review against docs/domains/temporal/safe-deployments.md, never automerge.',
      matchPackageNames: [
        'ghcr.io/mitchross/radar-ng-temporal-worker',
      ],
      automerge: false,
    },
    // PostHog sidecars are split across two rules: Renovate rejects matchUpdateTypes + versioning in one rule, and matching rules merge.
    // Never automerge PostHog images; review each bump against my-apps/development-infra/posthog/UPGRADE.md.
    {
      description: 'PostHog sidecars: declare loose versioning for master-<sha7> tag format.',
      // Docker Hub image: list every registry form or the rule silently never applies.
      matchPackageNames: [
        'posthog/posthog-node',
        'docker.io/posthog/posthog-node',
        'ghcr.io/posthog/posthog-node',
        'ghcr.io/posthog/posthog/capture',
        'ghcr.io/posthog/posthog/property-defs-rs',
        'ghcr.io/posthog/posthog/feature-flags',
        'ghcr.io/posthog/posthog/hypercache-server',
        'ghcr.io/posthog/posthog/livestream',
        'ghcr.io/posthog/posthog/cyclotron-janitor',
        'ghcr.io/posthog/posthog/cymbal',
      ],
      matchFileNames: ['my-apps/development-infra/posthog/**'],
      versioning: 'loose',
    },
    {
      description: 'PostHog sidecars (Rust + node): group into one PR per sweep, but do NOT auto-merge — the 2026-05-09 sharded_events outage was triggered by a sidecar digest auto-merge re-firing the migrate hook against a pre-existing CH config drift. A human reviewer must check each PR against the upstream commit range surfaced by the master-<sha7> tag format before merging.',
      matchPackageNames: [
        'posthog/posthog-node',
        'docker.io/posthog/posthog-node',
        'ghcr.io/posthog/posthog-node',
        'ghcr.io/posthog/posthog/capture',
        'ghcr.io/posthog/posthog/property-defs-rs',
        'ghcr.io/posthog/posthog/feature-flags',
        'ghcr.io/posthog/posthog/hypercache-server',
        'ghcr.io/posthog/posthog/livestream',
        'ghcr.io/posthog/posthog/cyclotron-janitor',
        'ghcr.io/posthog/posthog/cymbal',
      ],
      matchFileNames: ['my-apps/development-infra/posthog/**'],
      groupName: 'posthog images',
      matchUpdateTypes: ['digest', 'patch', 'minor'],
      automerge: false,
      schedule: ['every weekend'],
    },
    {
      description: 'PostHog MONOLITH (posthog/posthog): ride the same "posthog images" group PR as the sidecars — one PR per version roll, digests moving in lockstep with posthog-node (the migrate hook image must match web/worker). NEVER automerge: before merging, run the my-apps/development-infra/posthog/UPGRADE.md checklist (upstream named_collections/remote_servers diff, new sharded_* tables vs clickhouse-init, newly-required env, server entrypoint) — both prior posthog outages (2026-04-19, 2026-05-09) were config drift surfaced by an unreviewed image bump.',
      // Docker Hub image: list every registry form or the rule silently never applies.
      matchPackageNames: [
        'posthog/posthog',
        'docker.io/posthog/posthog',
        'ghcr.io/posthog/posthog',
      ],
      matchFileNames: ['my-apps/development-infra/posthog/**'],
      matchUpdateTypes: ['digest'],
      groupName: 'posthog images',
      automerge: false,
      schedule: ['every weekend'],
    },
    {
      description: 'PostHog data layer: disable auto-updates (versions must match PostHog docker-compose.base.yml)',
      // Keep the Docker Hub valkey/valkey form, or the minor/patch automerge rule applies to it.
      matchPackageNames: [
        'postgres',
        'valkey/valkey',
        'docker.io/valkey/valkey',
        'ghcr.io/valkey-io/valkey',
        'redis',
        'clickhouse/clickhouse-server',
        'docker.redpanda.com/redpandadata/redpanda',
      ],
      matchFileNames: ['my-apps/development-infra/posthog/**'],
      enabled: false,
    },
    {
      description: 'plain-Postgres images (all apps): MAJOR bumps require dependency-dashboard approval — PG data dirs are not major-version compatible; manual dump/restore needed (2026-07-17 incident PR #1621; repeated 2026-08-14 on temporal, PR #1979)',
      matchPackageNames: ['postgres', 'docker.io/library/postgres', 'postgis/postgis', 'docker.io/postgis/postgis', 'ghcr.io/immich-app/postgres'],
      matchFileNames: ['**/postgres/deployment.yaml', 'my-apps/ai/langfuse/postgres.yaml'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'temporal Postgres: hold at 17.x — Temporal upstream has not declared PG18 support; lifting the hold means a deliberate dump/restore migration (runbook 2026-07-18)',
      matchPackageNames: ['postgres'],
      matchFileNames: ['my-apps/development-infra/temporal/postgres/deployment.yaml'],
      allowedVersions: '<18',
    },
    {
      description: 'Pin project-nomad MySQL to 8.x (AdonisJS/Lucid not tested with MySQL 9)',
      matchPackageNames: ['mysql'],
      matchFileNames: ['my-apps/knowledge/project-nomad/**'],
      allowedVersions: '<9.0.0',
    },
    {
      description: 'temporal-worker-controller: chart and IMAGE share the same OCI repo (docker.io/temporalio/temporal-worker-controller). Image tags look like v1.5.x; chart tags look like 0.24.x. Constrain to chart-style (no `v` prefix, two-part minor) so Renovate cannot bump us onto an image tag (it did exactly that in #1224, breaking CI repo-wide for ~9 days because `helm pull` rejects a plain image OCI artifact with "manifest does not contain minimum number of descriptors").',
      matchPackageNames: [
        'docker.io/temporalio/temporal-worker-controller',
        'docker.io/temporalio/temporal-worker-controller-crds',
      ],
      allowedVersions: '/^\\d+\\.\\d+\\.\\d+$/',
    },
    {
      // The in-cluster Renovate re-enables these via force.packageRules, which is applied last and wins.
      description: 'Ignore all registry.vanillax.me image refs in the hosted GitHub App (LAN-only registry it cannot reach). Self-hosted in-cluster Renovate owns these via force config + custom.gitea-vanillax — see my-apps/development/renovate/configmap.yaml.',
      matchPackageNames: ['/^registry\\.vanillax\\.me//'],
      enabled: false,
    },
    {
      // 0.x minors are breaking and CRDs must be re-verified on every bump, so no automerge (PRs still open immediately).
      description: 'kopiur chart/image bumps require manual review — pre-1.0 breaking minors + announced breaking chart refactor (#203)',
      matchPackageNames: ['kopiur', 'ghcr.io/home-operations/charts/kopiur', 'ghcr.io/home-operations/kopiur-controller', 'ghcr.io/home-operations/kopiur-webhook', 'ghcr.io/home-operations/kopiur-mover'],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      // Argo CD manages itself: a wedged sync freezes the whole app-of-apps, so every chart bump waits for dashboard approval.
      description: 'argo-cd chart bumps require manual review — wedge-prone, see incident 2026-05-01 (PR #1259, v9.5.9). Bound-retry sweep added 2026-05-19 lessens blast radius but does not remove it.',
      matchDatasources: ['helm'],
      matchPackageNames: ['argo-cd'],
      registryUrls: ['https://argoproj.github.io/argo-helm'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      // deal-scout's release script opens its own GitOps PR for both images; a Renovate bump would race it and split their versions.
      // Keep this rule last: later rules win.
      description: 'deal-scout images are released by their own pipeline; Renovate must not bump them',
      matchPackageNames: [
        'ghcr.io/mitchross/deal-scout',
        'ghcr.io/mitchross/deal-scout-worker',
      ],
      enabled: false,
    },
  ],
  ignorePaths: [
    // Archived applications are excluded from Argo CD discovery.
    'my-apps/**/_archive/**',
    '**/charts/**',
    // ClusterPolicy fails Renovate's YAML parse, and its images are owned by the gpu-operator chart anyway.
    'infrastructure/gpu/nvidia-gpu-operator/cluster-policy.yaml',
  ],
  // Managers for the LAN registry live in the self-hosted config (my-apps/development/renovate/configmap.yaml);
  // these use public datasources and run in both instances.
  customManagers: [
    {
      description: 'Keep documented and bootstrap Argo CD chart versions aligned with GitOps',
      customType: 'regex',
      managerFilePatterns: [
        '/^README\\.md$/',
        '/^scripts/bootstrap-argocd\\.sh$/',
      ],
      matchStrings: [
        'helm upgrade --install argocd argo-cd[\\s\\S]*?--version\\s+(?<currentValue>[0-9.]+)',
      ],
      depNameTemplate: 'argo-cd',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://argoproj.github.io/argo-helm',
    },
    {
      description: 'Omni cluster template - Talos version',
      customType: 'regex',
      managerFilePatterns: [
        '/^omni/cluster-template/cluster-template-prod-v2\\.yaml$/',
      ],
      matchStrings: [
        'talos:\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s+version:\\s*(?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'ghcr.io/siderolabs/installer',
      datasourceTemplate: 'docker',
    },
    {
      description: 'Omni cluster template - Kubernetes version',
      customType: 'regex',
      managerFilePatterns: [
        '/^omni/cluster-template/cluster-template-prod-v2\\.yaml$/',
      ],
      matchStrings: [
        'kubernetes:\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s+version:\\s*(?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'ghcr.io/siderolabs/kubelet',
      datasourceTemplate: 'docker',
    },
    {
      description: 'K8sGPT operator CR image reference',
      customType: 'regex',
      managerFilePatterns: [
        '/^monitoring/k8sgpt/.+\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\n\\s+version:\\s*"?(?<currentValue>[\\w.]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      description: 'Kubernetes image volumes (volumes[].image.reference); the kubernetes manager only reads image: lines, so these would drift from the matching container image.',
      customType: 'regex',
      managerFilePatterns: [
        '/^my-apps/.+\\.yaml$/',
      ],
      matchStrings: [
        'reference:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
