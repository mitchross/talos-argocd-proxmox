      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code)(increase(litellm_proxy_total_requests_metric_total{requested_model=\"whisper\"}[$__interval]))",
