    {
      "id": 9,
      "type": "stat",
      "title": "Speed (x real time)",
      "description": "Audio length divided by time taken. 6x = an hour of audio in 10 minutes. From the LiteLLM transcription_metrics callback.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(transcription_audio_seconds_total[$__range])) / sum(increase(transcription_processing_seconds_total[$__range])) > 0",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "noValue": "No transcriptions",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      }
    },
