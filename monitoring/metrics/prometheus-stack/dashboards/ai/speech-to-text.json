    {
      "id": 13,
      "type": "timeseries",
      "title": "Speed over time",
      "description": "Per-window speed. Gaps mean no transcription finished in that window.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(transcription_audio_seconds_total[$__rate_interval])) / sum(increase(transcription_processing_seconds_total[$__rate_interval])) > 0",
          "legendFormat": "x real time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(transcription_words_total[$__rate_interval])) / sum(increase(transcription_processing_seconds_total[$__rate_interval])) > 0",
          "legendFormat": "words/s",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
