    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**qwen3.8-27b** (Qwen3.8-27B FP8) runs as one vLLM engine split across **both RTX 3090s** (tensor parallel 2). At most **2 requests** decode at once, 262K-token context, FP8 KV cache, prefix caching on, no speculative decoding. Apps reach it through the LiteLLM gateway.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Engine",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(vllm:engine_sleep_state{sleep_state=\"awake\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Asleep",
                  "color": "orange"
                },
                "1": {
                  "text": "Awake",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Down"
        },
        "overrides": []
