{
  "id": null,
  "uid": "homelab-now",
  "title": "Homelab now",
  "description": "What is broken right now. Green tiles and \"All clear\" tables mean nothing to do.",
  "tags": [
    "start-here",
    "alerts",
    "homelab"
  ],
  "editable": false,
  "schemaVersion": 42,
  "refresh": "1m",
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argo CD",
      "type": "link",
      "url": "https://argocd.vanillax.me",
      "targetBlank": true
