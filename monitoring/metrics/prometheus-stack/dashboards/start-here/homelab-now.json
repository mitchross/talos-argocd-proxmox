    {
      "id": 7,
      "type": "table",
      "title": "Alerts firing now",
      "description": "Each firing alert and how long it has been firing. Old KubeJobFailed alerts clear when the failed Job is deleted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(ALERTS_FOR_STATE{alertname!~\"Watchdog|InfoInhibitor\"} * 1000) and ignoring(alertstate) ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "alertname",
                "severity",
                "namespace",
                "job_name",
                "pod",
                "Value",
                "Alert",
                "Severity",
                "Namespace",
                "Job",
                "Pod",
                "Firing since"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "service": true,
              "prometheus": true,
              "otel_scope_name": true,
              "uid": true,
              "condition": true,
              "dest_server": true,
              "repo": true,
              "project": true,
              "phase_1": true,
              "autosync_enabled": true,
              "exported_namespace_1": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2,
              "job_name": 3,
              "pod": 4,
              "Value": 5
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "namespace": "Namespace",
              "job_name": "Job",
              "pod": "Pod",
              "Value": "Firing since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All clear",
          "custom": {
            "align": "left",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Firing since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
