    {
      "type": "table",
      "title": "Cards and the pods using them",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per card. Empty pod = card is idle.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "UTIL",
          "expr": "max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "VRAM",
          "expr": "max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_FB_USED) * 1024 * 1024",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "VRAMPCT",
          "expr": "100 * max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE + DCGM_FI_DEV_FB_RESERVED))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "POWER",
          "expr": "max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "TEMP",
          "expr": "max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "CLOCK",
          "expr": "max by (gpu, modelName, exported_namespace, exported_pod) (DCGM_FI_DEV_SM_CLOCK) * 1000000",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "gpu": 0,
              "modelName": 1,
              "exported_namespace": 2,
              "exported_pod": 3
            },
            "renameByName": {
              "gpu": "GPU",
              "modelName": "Card",
              "exported_namespace": "Namespace",
              "exported_pod": "Pod"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
