  "panels": [
    {
      "type": "text",
      "title": "How pi-auto routes",
      "options": {
        "mode": "markdown",
        "content": "Pi asks LiteLLM for **`pi-auto`**. Local Qwen (`pi-classifier`) grades **every request**: SIMPLE and MEDIUM stay on **local Qwen (free)**, COMPLEX and REASONING go to **DeepSeek Flash on OpenRouter (paid)**. Repeating tool calls, prompts too big for Qwen, a failed classification or a vLLM outage also send the request to DeepSeek.\n\nPi's own cost readout prices every request as DeepSeek; the spend here is LiteLLM's.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Stayed local (free)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * sum(increase(litellm_deployment_success_responses_total{requested_model=\"pi-auto\", litellm_model_name=~\"qwen3.8-27b.*\"}[$__range])) / (sum(increase(litellm_deployment_success_responses_total{requested_model=\"pi-auto\"}[$__range])) > 0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "noValue": "No pi-auto traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Share of pi-auto requests answered by your own GPUs.",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      }
    },
