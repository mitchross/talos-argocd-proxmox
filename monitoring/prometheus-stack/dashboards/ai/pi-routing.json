          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(litellm_request_total_latency_metric_sum{requested_model=\"pi-classifier\"}[$__rate_interval])) / sum(rate(litellm_request_total_latency_metric_count{requested_model=\"pi-classifier\"}[$__rate_interval]))",
