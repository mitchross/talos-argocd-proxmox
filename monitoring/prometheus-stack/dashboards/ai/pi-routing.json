    {
      "type": "piechart",
      "title": "Local vs paid",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every completed pi-auto request, by the backend that ran it.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (litellm_model_name) (increase(litellm_deployment_success_responses_total{requested_model=\"pi-auto\"}[$__range]))",
          "legendFormat": "{{litellm_model_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*qwen.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "Local Qwen (free)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*deepseek.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "displayName",
                "value": "DeepSeek Flash (paid)"
              }
