{
  "id": null,
  "uid": "pi-routing",
  "title": "Pi Auto-Routing: Local or Paid?",
  "description": "How LiteLLM's pi-auto route splits Pi's requests between local Qwen (free) and DeepSeek Flash on OpenRouter (paid), and what that costs.",
  "tags": [
    "ai",
    "litellm",
    "pi"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
