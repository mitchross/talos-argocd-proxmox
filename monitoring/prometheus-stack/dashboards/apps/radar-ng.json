      },
      "id": 107
    },
    {
      "type": "logs",
      "title": "Widget, Watch and CarPlay requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 60
      },
