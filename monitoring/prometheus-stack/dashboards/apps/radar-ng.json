    {
      "type": "stat",
      "title": "CarPlay requests \u2014 24h",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({k8s_namespace_name=\"radar-ng\", k8s_container_name=\"tile-server\"} |= \"handled request\" | regexp `(?P<body>\\{.*)` | line_format \"{{.body}}\" | json ua=`request.headers[\"User-Agent\"][0]`, uri=`request.uri`, status=`status`, duration=`duration` | __error__=\"\" | ua !~ \"kube-probe.*|Prometheus.*\" | ua =~ \"RadarNG-CarPlay.*\" [24h])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
