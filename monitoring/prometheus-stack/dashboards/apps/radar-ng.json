{
  "title": "radar-ng",
  "uid": "radar-ng-overview",
  "tags": [
    "radar-ng",
    "weather"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MRMS radar data age",
      "description": "Time since the newest radar tile was written. Should stay < 300s during normal MRMS polling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(radar_ng_mrms_age_seconds)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tile-server requests by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(radar_ng_manifest_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "manifest",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(radar_ng_forecast_requests_total[5m]))",
          "refId": "B",
          "legendFormat": "forecast",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Forecast cache hit rate",
      "description": "Share of Open-Meteo forecast requests served from cache over the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(100 * sum(rate(radar_ng_forecast_cache_hits_total[1h])) / sum(rate(radar_ng_forecast_requests_total[1h]))) > -1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "noValue": "No forecast traffic"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Log volume by container",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (k8s_container_name) (count_over_time({k8s_namespace_name=\"radar-ng\"}[$__auto]))",
          "refId": "A",
          "legendFormat": "{{k8s_container_name}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "description": "Log lines per container. A sudden drop to zero means a container stopped working or logging."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Forecast upstream errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(radar_ng_forecast_upstream_errors_total[5m]))",
          "refId": "A",
          "legendFormat": "errors/sec",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "description": "Failed calls from tile-server to the Open-Meteo forecast upstream."
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent error lines (all radar-ng containers)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{k8s_namespace_name=\"radar-ng\"} |~ \"(?i)error|exception|traceback|failed\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tile timestamps per layer",
      "description": "Number of available timestamp slices per rendered layer. Drops here usually indicate an ingestor stall.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (layer) (radar_ng_tile_timestamps)",
          "refId": "A",
          "legendFormat": "{{layer}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Backend pressure",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pod CPU vs request",
      "description": "Per-pod CPU consumption normalized to the pod's CPU request. >100% means the pod is bursting into limit headroom; sustained >70% on tile-server triggers HPA scale-out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"radar-ng\", container!=\"\", container!=\"POD\"}[5m])) / on (pod) group_left sum by (pod) (kube_pod_container_resource_requests{namespace=\"radar-ng\", resource=\"cpu\"})",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pod memory vs limit",
      "description": "Working set as percent of memory limit. >85% sustained = OOM kill risk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (container_memory_working_set_bytes{namespace=\"radar-ng\", container!=\"\", container!=\"POD\"}) / on (pod) group_left sum by (pod) (kube_pod_container_resource_limits{namespace=\"radar-ng\", resource=\"memory\"})",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tile-server replicas (HPA)",
      "description": "Current vs desired vs min/max. If current pins at maxReplicas you're undersized — bump the HPA cap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"radar-ng\", horizontalpodautoscaler=\"tile-server\"}",
          "refId": "A",
          "legendFormat": "current",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"radar-ng\", horizontalpodautoscaler=\"tile-server\"}",
          "refId": "B",
          "legendFormat": "desired",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"radar-ng\", horizontalpodautoscaler=\"tile-server\"}",
          "refId": "C",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"radar-ng\", horizontalpodautoscaler=\"tile-server\"}",
          "refId": "D",
          "legendFormat": "min",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "OOM kills — 1h",
      "description": "Pods killed for exceeding memory limit in the last hour. Should be 0 in steady state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(increase(container_oom_events_total{namespace=\"radar-ng\"}[1h])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Container restarts — 1h",
      "description": "All restarts in radar-ng over the last hour. A tile-server spike is the one to chase.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 40,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"radar-ng\"}[1h])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    }
  ],
  "id": null,
  "description": "radar-ng backend: data freshness, tile-server traffic, forecast cache, error logs, and pod pressure."
}
