{
  "title": "Storage & SSD wear",
  "uid": "storage-ssd-wear",
  "tags": [
    "storage",
    "longhorn",
    "kopiur"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Are the SSDs being worn out?",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "SSDs: TB written in the last 24 h",
      "description": "All physical drives in the Proxmox hosts (the NAS excluded). LVM and RAID layers are left out so bytes are not counted twice. Aim: 1.5 TB/day or less.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(node_disk_written_bytes_total{job=\"physical-node\",disk!~\"dm-.*|md.*\",physical_host!=\"truenas\"}[1d])) / 1e12",
          "legendFormat": "TB/day",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 2.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "SSDs: TB written per day, rolling",
      "description": "Each point is the total written in the 24 hours before it. A sudden rise usually means one new pod; find it in the tables below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(node_disk_written_bytes_total{job=\"physical-node\",disk!~\"dm-.*|md.*\",physical_host!=\"truenas\"}[1d])) / 1e12",
          "legendFormat": "fleet TB/day",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h"
    },
    {
      "type": "bargauge",
      "title": "GB written per drive, last 24 h",
      "description": "Which physical drive takes the writes. The Threadripper HPE mirror (sdb/sdc) is the enterprise drive built for heavy writes; every other drive is consumer-grade.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 4,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (physical_host,disk) (increase(node_disk_written_bytes_total{job=\"physical-node\",disk!~\"dm-.*|md.*\",physical_host!=\"truenas\"}[1d])) / 1e9)",
          "legendFormat": "{{physical_host}} {{disk}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "SSD life used (NVMe drives)",
      "description": "Percent of rated write endurance used, from SMART. Plan a replacement above 80%. SATA drives report wear differently; see the Hardware diagnostics dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 5,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "max by (physical_host,device) (smartctl_device_percentage_used)",
          "legendFormat": "{{physical_host}} {{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Top 10 pods by GB written, last 24 h",
      "description": "Writes counted against each pod, across all its disks. The usual fix for a heavy writer is in docs/domains/storage/disk-writes.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "topk(10, sum by (namespace,pod) (increase(container_fs_writes_bytes_total{container!=\"\"}[1d])) / 1e9)",
          "legendFormat": "{{namespace}}/{{pod}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Top 10 pods by GB read, last 24 h",
      "description": "Huge reads usually mean an app re-reads the same data because its memory limit leaves no room for cache (Prometheus did this). Reads don't wear SSDs much but load the disk and network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 7,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "expr": "topk(10, sum by (namespace,pod) (increase(container_fs_reads_bytes_total{container!=\"\"}[1d])) / 1e9)",
          "legendFormat": "{{namespace}}/{{pod}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Is Longhorn running out of room?",
      "collapsed": false,
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Longhorn space booked vs. limit, per node",
      "description": "Longhorn reserves each volume's full requested size. A node can book up to 200% of its disk space (overprovisioning). Near 100%, new volumes and backup clones can't be placed. Per node: the GPU node's two disks are added together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sort_desc(100 * max by (node) (longhorn_node_storage_scheduled_bytes) / (2 * max by (node) (longhorn_node_storage_capacity_bytes)))",
          "legendFormat": "{{node}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Longhorn disk actually used",
      "description": "Real data on each Longhorn disk, as a share of its size. Much lower than 'booked' above is normal; it means volumes ask for more than they use.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "sort_desc(100 * max by (node,disk) (longhorn_disk_usage_bytes) / max by (node,disk) (longhorn_disk_capacity_bytes))",
          "legendFormat": "{{node}} {{disk}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Are backups running?",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Hours since each backup last succeeded",
      "description": "One bar per kopiur backup policy. Daily backups should stay under ~26 h and 6-hourly ones under ~8 h. A bar that keeps growing is a stuck backup.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 12,
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "sort_desc((time() - max by (exported_namespace,policy) (kopiur_policy_last_backup_success_timestamp_seconds)) / 3600)",
          "legendFormat": "{{exported_namespace}}/{{policy}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 26
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "NAS free space per pool",
      "description": "TB free on each TrueNAS pool. BigTank holds bulk data and the kopiur backup repository; keep it under about 80% full.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 13,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "max by (mountpoint) (node_filesystem_avail_bytes{physical_host=\"truenas\",mountpoint=~\"/mnt/(BigTank|ai-pool|Backup10T)\"}) / 1e12",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "description": "Is anything wearing out the SSDs, filling a Longhorn disk, or blocking a backup? Layout of every disk: docs/domains/storage/disk-map.md"
}