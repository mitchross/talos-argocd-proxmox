    },
    {
      "type": "bargauge",
      "id": 14,
      "title": "Critical and high by namespace",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (namespace) (max by (namespace, image_digest, severity) (trivy_image_vulnerabilities{severity=~\"Critical|High\",namespace=~\"$namespace\"})) > 0)",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "table",
      "id": 15,
      "title": "Vulnerabilities by image",
      "description": "One row per image and tag. Images with only Unknown-severity findings are hidden.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "Critical",
          "expr": "max by (image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Critical\",namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "High",
          "expr": "max by (image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"High\",namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "Medium",
          "expr": "max by (image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Medium\",namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "Low",
          "expr": "max by (image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Low\",namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "Unknown",
          "expr": "max by (image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Unknown\",namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "image_repository": "Image",
              "image_tag": "Tag",
              "namespace": "Namespace",
              "Value #Critical": "Critical",
              "Value #High": "High",
              "Value #Medium": "Medium",
              "Value #Low": "Low",
              "Value #Unknown": "Unknown"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "all",
            "filters": [
              {
                "fieldName": "Critical",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "High",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "Medium",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "Low",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Critical",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "dark-red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
