{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "title": "VPA Recommendations",
  "uid": "vpa-recommendations",
  "tags": [
    "kubernetes",
    "vpa",
    "capacity"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_verticalpodautoscaler_spec_updatepolicy_updatemode, namespace)",
          "refId": "Namespace"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "query",
        "name": "target",
        "label": "Target",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_verticalpodautoscaler_spec_updatepolicy_updatemode{namespace=~\"$namespace\"}, target_name)",
          "refId": "Target"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "VPA policy status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Active VPAs",
      "description": "VPAs using in-place resize with recreate fallback.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(kube_verticalpodautoscaler_spec_updatepolicy_updatemode{namespace=~\"$namespace\",target_name=~\"$target\",update_mode=\"InPlaceOrRecreate\"} == 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "VPAs with recommendations",
      "description": "Targets where the recommender has emitted CPU recommendations.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (namespace, verticalpodautoscaler) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=~\"$namespace\",target_name=~\"$target\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Max target CPU",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Max target memory",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8589934592
              },
              {
                "color": "red",
                "value": 34359738368
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Recommendations",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "table",
      "id": 10,
      "title": "CPU target recommendations",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "TARGET",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "LOWER",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_lowerbound_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "UPPER",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_upperbound_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "UNCAPPED",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_uncappedtarget_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "target_kind": 1,
              "target_name": 2,
              "verticalpodautoscaler": 3,
              "container": 4,
              "Value #LOWER": 5,
              "Value #TARGET": 6,
              "Value #UPPER": 7,
              "Value #UNCAPPED": 8
            },
            "renameByName": {
              "namespace": "Namespace",
              "target_kind": "Kind",
              "target_name": "Target",
              "verticalpodautoscaler": "VPA",
              "container": "Container",
              "Value #TARGET": "Recommended",
              "Value #LOWER": "Lower",
              "Value #UPPER": "Upper",
              "Value #UNCAPPED": "Uncapped"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3
        }
      },
      "options": {
        "showHeader": true
      },
      "description": "Values are CPU cores."
    },
    {
      "type": "table",
      "id": 11,
      "title": "Memory target recommendations",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "TARGET",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "LOWER",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_lowerbound_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "UPPER",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_upperbound_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "UNCAPPED",
          "expr": "max by (namespace, verticalpodautoscaler, target_kind, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_uncappedtarget_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "target_kind": 1,
              "target_name": 2,
              "verticalpodautoscaler": 3,
              "container": 4,
              "Value #LOWER": 5,
              "Value #TARGET": 6,
              "Value #UPPER": 7,
              "Value #UNCAPPED": 8
            },
            "renameByName": {
              "namespace": "Namespace",
              "target_kind": "Kind",
              "target_name": "Target",
              "verticalpodautoscaler": "VPA",
              "container": "Container",
              "Value #TARGET": "Recommended",
              "Value #LOWER": "Lower",
              "Value #UPPER": "Upper",
              "Value #UNCAPPED": "Uncapped"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "CPU target over time",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=~\"$namespace\",target_name=~\"$target\"}",
          "legendFormat": "{{namespace}}/{{target_name}} {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 2
        }
      }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Memory target over time",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_memory{namespace=~\"$namespace\",target_name=~\"$target\"}",
          "legendFormat": "{{namespace}}/{{target_name}} {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Request pressure smell tests",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "bargauge",
      "id": 30,
      "title": "Current CPU request / VPA CPU target",
      "description": "Per-pod request divided by the VPA target. Around 1 = matched; above 1 = over-requested.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (namespace, target_name, container) (label_replace(kube_pod_container_resource_requests{resource=\"cpu\",unit=\"core\",namespace=~\"$namespace\",container!=\"\"} * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel, \"target_name\", \"$1\", \"workload\", \"(.*)\"))\n/ on (namespace, target_name, container)\nmax by (namespace, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "legendFormat": "{{namespace}}/{{target_name}} {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "bargauge",
      "id": 31,
      "title": "Current memory request / VPA memory target",
      "description": "Per-pod request divided by the VPA target. Around 1 = matched; above 1 = over-requested.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (namespace, target_name, container) (label_replace(kube_pod_container_resource_requests{resource=\"memory\",unit=\"byte\",namespace=~\"$namespace\",container!=\"\"} * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel, \"target_name\", \"$1\", \"workload\", \"(.*)\"))\n/ on (namespace, target_name, container)\nmax by (namespace, target_name, container) (kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_memory{namespace=~\"$namespace\",target_name=~\"$target\"})",
          "legendFormat": "{{namespace}}/{{target_name}} {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "id": null,
  "description": "What the Vertical Pod Autoscaler recommends for each workload, and how current requests compare."
}
