{
  "uid": "node-crash-logs",
  "title": "Nodes / Crash logs",
  "schemaVersion": 42,
  "version": 1,
  "tags": [
    "nodes",
    "logs",
    "crashes"
  ],
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Physical hardware diagnostics",
      "type": "link",
      "url": "/d/homelab-diagnostics",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host or Talos node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service_name=~\"talos-system|host-journal\"}, host_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Talos readiness",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A missing series is unknown, not healthy.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\",node=~\"${host:regex}\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Physical host reachability",
      "type": "state-timeline",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "This checks the hypervisor separately from its Talos guest.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"physical-node\",physical_host=~\"${host:regex}\"}",
          "legendFormat": "{{physical_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Last boot — physical hosts",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Boot time is not a diagnosis of why a node restarted.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_boot_time_seconds{job=\"physical-node\",physical_host=~\"${host:regex}\"} * 1000",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host_type": true
            },
            "renameByName": {
              "physical_host": "Host",
              "Value": "Boot time"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Last boot — Talos guests",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Compare with physical boot time to distinguish a host reboot from a guest restart.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(node_boot_time_seconds{job=\"node-exporter\"} * on(namespace,pod) group_left(node) max by(namespace,pod,node)(kube_pod_info{namespace=\"prometheus-stack\",node=~\"${host:regex}\"})) * 1000",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pod": true,
              "namespace": true,
              "container": true,
              "endpoint": true,
              "service": true
            },
            "renameByName": {
              "node": "Node",
              "Value": "Boot time"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Kernel OOM kills — all nodes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Kernel OOM counters cover the whole host or guest. Zero does not exclude a non-OOM crash.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(node_vmstat_oom_kill[$__rate_interval])",
          "legendFormat": "{{physical_host}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Physical log collectors",
      "type": "state-timeline",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Down until the host logging playbook is deployed. An up collector can still have delivery errors.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"physical-logs\",physical_host=~\"${host:regex}\"}",
          "legendFormat": "{{physical_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Crash and shutdown clues",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Matches are clues, not proof of a crash. Expand a physical journal entry for boot ID and systemd unit.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"talos-system|host-journal\",host_name=~\"${host:regex}\"} |~ \"(?i)(kernel panic|watchdog|out of memory|oom-kill|killed process|I/O error|thermal|hardware error|unclean|segfault|shutdown|reboot)\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "title": "Node logs — full context",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Seven-day retention for these node streams. A sudden power cut may produce no final message.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"talos-system|host-journal\",host_name=~\"${host:regex}\"} |= ${search:doublequote}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 9,
      "title": "Log delivery failures — all node collectors",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Retry attempts can repeat for the same batch; this is not a count of unique lost log lines.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(instance,exporter) (rate({__name__=~\"otelcol_exporter_send_failed_log_records(_total)?\",exporter=~\"otlphttp/node_logs|otlphttp/loki\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Disk queue usage — all node collectors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Finite local queues backpressure producers when full. Check free space and Loki if usage keeps rising.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * otelcol_exporter_queue_size{exporter=~\"otlphttp/node_logs|otlphttp/loki\"} / otelcol_exporter_queue_capacity{exporter=~\"otlphttp/node_logs|otlphttp/loki\"}",
          "legendFormat": "{{instance}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "id": null
}
