    {
      "id": 12,
      "type": "row",
      "title": "PER WORKLOAD — MEMORY: requested vs real peak (running short = OOM kill)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "table",
      "title": "Memory: request vs peak vs limit (per pod)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 15,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, workload) (sum by (namespace, pod) (cluster:namespace:pod_memory:active:kube_pod_container_resource_requests) * on (namespace, pod) group_left (workload) label_replace(namespace_workload_pod:kube_pod_owner:relabel, \"workload\", \"$1\", \"workload\", \"(.+)-v[0-9]+-[0-9]+-[0-9]+-[a-z0-9]+\"))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, workload) (max_over_time(workload:memory_working_set_bytes:pod_max[$window])) and on (namespace, workload) max by (namespace, workload) (sum by (namespace, pod) (cluster:namespace:pod_memory:active:kube_pod_container_resource_requests) * on (namespace, pod) group_left (workload) label_replace(namespace_workload_pod:kube_pod_owner:relabel, \"workload\", \"$1\", \"workload\", \"(.+)-v[0-9]+-[0-9]+-[0-9]+-[a-z0-9]+\"))",
          "instant": true,
          "range": false,
