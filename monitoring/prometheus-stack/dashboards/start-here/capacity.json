{
  "id": null,
  "uid": "capacity",
  "title": "Capacity — requests vs real use",
  "description": "Where memory and CPU are reserved vs actually used, per node and per workload, against peaks not snapshots.",
  "tags": [
    "kubernetes",
    "capacity",
    "vpa",
    "start-here"
  ],
  "editable": false,
  "schemaVersion": 42,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Peak window",
        "type": "custom",
        "query": "1d,7d,15d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "options": [
          {
            "text": "1d",
            "value": "1d",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          },
          {
            "text": "15d",
            "value": "15d",
            "selected": false
          }
        ],
        "description": "Prometheus keeps 15 days, so that's the longest honest window."
      }
    ]
  },
  "links": [
    {
      "title": "VPA Recommendations",
      "type": "link",
      "url": "/d/vpa-recommendations"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "CLUSTER AT A GLANCE — requests reserve space, usage is what's really burned",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory requested",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(cluster:namespace:pod_memory:active:kube_pod_container_resource_requests) / sum(kube_node_status_allocatable{resource=\"memory\"})",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Share of allocatable memory reserved by pod requests. This is what the scheduler sees."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(sum by (node) (node_namespace_pod_container:container_memory_working_set_bytes{container!=\"\"})) / sum(kube_node_status_allocatable{resource=\"memory\"})",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Live working set as a share of allocatable."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory limits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(cluster:namespace:pod_memory:active:kube_pod_container_resource_limits) / sum(kube_node_status_allocatable{resource=\"memory\"})",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 150
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Over 100% = overcommitted: if several pods spike at once the kernel OOM-kills."
    },
