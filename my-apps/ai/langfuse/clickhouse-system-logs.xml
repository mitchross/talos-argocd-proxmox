<clickhouse>
  <!-- Internal telemetry tables outgrew the trace data (3+ GiB vs 1 GiB) and drove the disk-write/backup-clone churn. -->
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <processors_profile_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_metric_log remove="1"/>
  <latency_log remove="1"/>
</clickhouse>
