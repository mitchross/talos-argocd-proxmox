{
    admin off
    auto_https off
}
:8080 {
    header {
        >Cache-Control "no-store"
        X-Practice-Environment "{$PRACTICE_ENV}"
        X-Release-Slot "{$RELEASE_SLOT}"
        X-Service-Version "{$SERVICE_VERSION}"
    }
    @identity {
        method GET
        path /practice
    }
    handle @identity {
        header Content-Type application/json
        respond `{"app":"radar-practice","environment":"{$PRACTICE_ENV}","slot":"{$RELEASE_SLOT}","version":"{$SERVICE_VERSION}"}` 200
    }
    @api {
        method GET
        path /api/livez /api/tropical /api/metrics
    }
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        respond "Read-only Radar practice API: /practice or /api/tropical" 404
    }
    log {
        output stdout
        format json
    }
}
