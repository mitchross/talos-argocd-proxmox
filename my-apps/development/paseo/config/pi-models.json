          "enable_thinking": {
            "$var": "thinking.enabled"
          },
          "reasoning_effort": {
            "$var": "thinking.effort",
            "omitWhenOff": true
          },
          "preserve_thinking": {
            "$var": "thinking.enabled"
          }
        }
      },
