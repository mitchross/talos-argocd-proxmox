#!/command/with-contenv bash
# Replaces the image's s6 run script. Archive is OFF: hat loads every row it archives into RAM
# at once, and a backlog >2M rows OOM-killed the pod in a loop (2026-10-16).

set -e
cd /app

DB_HIGH_SIZE='50000'
DB_LOW_SIZE='10000'

DIR="${XDG_STATE_HOME:-/config/state}/hat"
DATABASE="${DIR}/syslog.db"

mkdir -p "${DIR}"
chown -R app:app "${DIR}"
chmod 0700 "${DIR}"

# These logs are disposable: hat crashes on a corrupt DB, so start fresh instead of crash-looping.
if [ -f "${DATABASE}" ] && ! python3 -c 'import sqlite3, sys
sys.exit(sqlite3.connect(sys.argv[1]).execute("PRAGMA quick_check(1)").fetchone()[0] != "ok")' "${DATABASE}" 2>/dev/null; then
    rm -f "${DATABASE}" "${DATABASE}-journal" "${DATABASE}-wal" "${DATABASE}-shm"
fi
rm -f "${DATABASE}.broken"

exec s6-setuidgid app \
    hat-syslog-server --log-level 'INFO' \
        --db-high-size "${DB_HIGH_SIZE}" --db-low-size "${DB_LOW_SIZE}" \
        --db-path "${DATABASE}"
