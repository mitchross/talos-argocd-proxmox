# Level II shadow pilot (radar-ng#293): read by level2-api, level2-publisher and level2-shadow-recorder only.
# Never unset: the code enables KGRR when this is missing. Every id must be in FEED_VERIFIED.
LEVEL2_ENABLED_STATIONS=KGRR,KDTX,KOUN,KFFC,KATX
LEVEL2_NUMERIC_ENABLED=true
LEVEL2_VIEWPORT_ENABLED=true
LEVEL2_TILE_ENABLED=true
LEVEL2_SHADOW_ENABLED=true
LEVEL2_OBJECT_PREFIX=level2/pool
LEVEL2_PG_SCHEMA=level2_numeric
LEVEL2_S3_ENDPOINT=http://192.168.10.133:30292
LEVEL2_S3_BUCKET=radar-ng-level2
LEVEL2_SHADOW_API_URL=http://level2-api.radar-ng.svc.cluster.local:8080
LEVEL2_SHADOW_EDGE_URL=https://radar-l2-shadow.vanillax.me
LEVEL2_SHADOW_COLD_EVERY_S=1800
LEVEL2_SHADOW_PROM_URL=http://kube-prometheus-stack-prometheus.prometheus-stack.svc.cluster.local:9090
LEVEL2_SHADOW_PROM_NAMESPACE=radar-ng
LEVEL2_TEST_FEED_DELAY_S=0
