# ==============================================================================
# PROXMOX INFRASTRUCTURE PROVIDER CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains secrets!

# ==============================================================================
# REQUIRED: Omni Configuration
# ==============================================================================

# Your Omni instance API endpoint
# Use your Omni domain with HTTPS
OMNI_API_ENDPOINT=https://omni.example.com/

# Infrastructure Provider Key. Generate with the CLI:
#   omnictl infraprovider create proxmox-dell
# The key is shown EXACTLY ONCE - capture it immediately.
#
# Do NOT generate this in the Omni UI: UI-generated PGP keys are incompatible
# with the CLI's gopenpgp library and fail with `EdDSA verification failure`.
#
# IMPORTANT: This is an Infrastructure Provider Key, NOT a service account key.
# Provider IDs must be valid DNS labels (lowercase, digits, dashes) as of v1.10.
OMNI_INFRA_PROVIDER_KEY=your-infra-provider-key-here

# ==============================================================================
# NOTES
# ==============================================================================
# - Proxmox credentials are configured in config.yaml
# - Make sure to create config.yaml from config.yaml.example
# - Secure this file: chmod 600 .env
