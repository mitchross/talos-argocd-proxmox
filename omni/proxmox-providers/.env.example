# Copy to .env (chmod 600). .env is gitignored.
OMNI_API_ENDPOINT=https://omni.vanillax.me:443

# One Infrastructure Provider Key per provider id, minted with
# `omnictl infraprovider create <id>` (shown once; NOT a service-account key;
# mint with the CLI, UI-generated keys fail EdDSA verification in omnictl).
OMNI_INFRA_PROVIDER_KEY_THREADRIPPER=   # proxmox-threadripper
OMNI_INFRA_PROVIDER_KEY_HP_MICRO=       # proxmox-hp-micro
OMNI_INFRA_PROVIDER_KEY_HP_SFF=         # proxmox-hp-sff
OMNI_INFRA_PROVIDER_KEY_HP_ELITE=       # proxmox-hp-elite
OMNI_INFRA_PROVIDER_KEY_DELL=           # proxmox-dell
