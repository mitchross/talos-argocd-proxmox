# Copy to dell.config.yaml and fill in credentials. *.config.yaml is gitignored.
proxmox:
  # Dell OptiPlex 7060 host (wired 2.5GbE).
  url: "https://192.168.10.16:8006/api2/json"
  insecureSkipVerify: true

  # Dedicated omni@pve account with the Administrator role at `/`, same as the
  # HP hosts. API tokens are NOT used: they have had insufficient permissions
  # AND the user@realm!tokenid secret format breaks on special characters.
  username: "omni"
  password: "CHANGE_ME"
  realm: "pve"
