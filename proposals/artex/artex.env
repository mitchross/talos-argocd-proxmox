# Non-secret ARTEX settings (configMapGenerator artex-config). ARTEX_PG_DSN comes from the ExternalSecret.
# The LLM values seed the engine only until a profile is saved in the UI: a saved DB profile wins over env.
ARTEX_JWT_KEY_DIR=/app/keys
# "ollama" is ARTEX's keyless OpenAI Chat Completions mode. There is no Ollama daemon: it talks to vLLM.
# Direct to local vLLM on purpose: LiteLLM's qwen alias can fall back to a paid cloud model, and ARTEX must not.
ARTEX_LLM_PROVIDER=ollama
ARTEX_LLM_BASE_URL=http://vllm-service.vllm.svc.cluster.local:8080/v1
ARTEX_LLM_MODEL=qwen3.8-27b
# Lets the UI model list (POST /api/llm/models) contact this one private host:port; nothing else private.
ARTEX_LLM_PRIVATE_ENDPOINTS=vllm-service.vllm.svc.cluster.local:8080
ARTEX_NOISE_PROFILE=quiet
# Off: no request to the public GitHub releases API (egress is blocked anyway).
ARTEX_UPDATE_CHECK=0
